  "organizzazione-aziendale": ["economia-aziendale"],
  "psicologia-generale": ["fisiologia"],
  "psicologia-sociale": ["fisiologia"],
  "psicologia-dello-sviluppo": ["fisiologia"],
  "neurofisiologia": ["fisiologia"],
  "psicometria": ["statistica"]
};

const AREA_INDEX = {};

for (const slug of Object.keys(EXAM_AREAS)) {
  AREA_INDEX[slug] = EXAM_AREAS[slug];
}

registraAree(AREA_INDEX);

for (const slug of Object.keys(EXAM_ALIASES)) {
  if (AREA_INDEX[slug]) continue;
  const sorgente = EXAM_ALIASES[slug];
  for (let i = 0; i < sorgente.length; i++) {
    if (AREA_INDEX[sorgente[i]]) {
      AREA_INDEX[slug] = {
        name: AREA_INDEX[sorgente[i]].name,
        areas: AREA_INDEX[sorgente[i]].areas,
        aliasOf: sorgente[i]
      };
      break;
    }
  }
}

/* ============================================================
   COPERTURA
   ============================================================ */
function examCoverage(slug) {
  const def = AREA_INDEX[slug];
  const aree = def ? def.areas.length : 0;
  return {
    available: aree >= MIN_AREAS,
    areas: aree,
    templates: aree,
    minRequired: MIN_AREAS,
    aliasOf: def && def.aliasOf ? def.aliasOf : null
  };
}

function planDistribution(areaCount, total) {
  const plan = [];
  let i = 0;
  while (plan.length < total) {
    plan.push(i % areaCount);
    i++;
  }
  return plan;
}

/* ============================================================
   GENERAZIONE DELLA SESSIONE — esattamente 10 domande
   ============================================================ */
function buildQuestion(rng, areaDef, examSlug) {
  for (let attempt = 0; attempt < 12; attempt++) {
    const gen = GENERATORS[areaDef.kind];
    if (!gen) return null;

    let built;
    try {
      built = gen(rng, areaDef.spec);
    } catch (e) {
      continue;
    }
    if (!built) continue;

    if (built.numeric) {
      const num = buildNumericOptions(built.numeric.value, {
        unit: built.numeric.unit,
        factor: built.numeric.factor,
        decimals: built.numeric.decimals
      });
      if (!validateOptions(num.options)) continue;
      const testi = num.options.map(function (o) { return o.text; });
      const mescolati = shuffleFisherYates(rng, testi);
      return {
        kind: areaDef.kind,
        areaId: areaDef.id,
        areaName: areaDef.name,
        examName: examSlug,
        prompt: built.prompt,
        options: mescolati,
        correctIndex: mescolati.indexOf(num.options[0].text),
        correct_answer: num.options[0].text,
        distractors: num.distractors,
        explanation: built.explanation,
        errorNote: built.errorNote,
        distractorNotes: num.distractors
      };
    }

    if (!validateOptions(built.options)) continue;
    const corretta = built.options.filter(function (o) { return o.correct; })[0].text;
    const testi = built.options.map(function (o) { return o.text; });
    const mescolati = shuffleFisherYates(rng, testi);
    return {
      kind: areaDef.kind,
      areaId: areaDef.id,
      areaName: areaDef.name,
      examName: examSlug,
      prompt: built.prompt,
      options: mescolati,
      correctIndex: mescolati.indexOf(corretta),
      correct_answer: corretta,
      distractors: testi.filter(function (t) { return t !== corretta; }),
      explanation: built.explanation || null,
      errorNote: built.errorNote,
      distractorNotes: built.options.filter(function (o) { return !o.correct; }).map(function (o) { return o.why; })
    };
  }
  return null;
}

function generateSession(slug, seed) {
  const def = AREA_INDEX[slug];
  if (!def || def.areas.length < MIN_AREAS) {
    return {
      ok: false,
      reason: def ? "copertura" : "materia-non-coperta",
      examSlug: slug,
      coverage: def ? def.areas.length : 0,
      minRequired: MIN_AREAS
    };
  }

  const rng = createRng(seed);
  const plan = planDistribution(def.areas.length, QUESTIONS_PER_SESSION);
  const questions = [];
  const seenPrompts = {};
  const usedAreaCount = {};
  let ripetizioniScartate = 0;

  for (let i = 0; i < plan.length; i++) {
    const areaDef = def.areas[plan[i]];
    const prevKind = questions.length ? questions[questions.length - 1].kind : null;

    let placed = null;
    for (let attempt = 0; attempt < 14; attempt++) {
      const cand = buildQuestion(rng, areaDef, slug);
      if (!cand) continue;
      if (seenPrompts[cand.prompt]) { ripetizioniScartate++; continue; }
      if (prevKind && cand.kind === prevKind) { ripetizioniScartate++; continue; }
      seenPrompts[cand.prompt] = true;
      placed = cand;
      break;
    }

    if (!placed) {
      const lastKind = questions.length ? questions[questions.length - 1].kind : null;
      for (let k = 0; k < def.areas.length; k++) {
        const alt = def.areas[k];
        if (alt.kind === lastKind) continue;
        const cand = buildQuestion(rng, alt, slug);
        if (cand && !seenPrompts[cand.prompt]) {
          seenPrompts[cand.prompt] = true;
          placed = cand;
          break;
        }
      }
    }

    if (placed) {
      usedAreaCount[placed.areaId] = (usedAreaCount[placed.areaId] || 0) + 1;
      questions.push({
        id: slug + "-q" + (questions.length + 1),
        number: questions.length + 1,
        areaId: placed.areaId,
        areaName: placed.areaName,
        kind: placed.kind,
        prompt: placed.prompt,
        options: placed.options,
        correctIndex: placed.correctIndex,
        correct_answer: placed.correct_answer,
        distractors: placed.distractors,
        explanation: placed.explanation,
        errorNote: placed.errorNote,
        distractorNotes: placed.distractorNotes
      });
    }
  }

  if (questions.length !== QUESTIONS_PER_SESSION) {
    return { ok: false, reason: "generation", examSlug: slug, generated: questions.length };
  }

  return {
    ok: true,
    examSlug: slug,
    examName: def.name,
    aliasOf: def.aliasOf || null,
    seed: seed,
    total: QUESTIONS_PER_SESSION,
    questions: questions,
    areaCount: Object.keys(usedAreaCount).length,
    repeatsDiscarded: ripetizioniScartate,
    distribution: usedAreaCount
  };
}

function gradeSession(session, answers) {
  let score = 0;
  const detail = session.questions.map(function (q, i) {
    const given = answers[i];
    const correct = given === q.correctIndex;
    if (correct) score++;
    return {
      number: i + 1,
      area: q.areaName,
      prompt: q.prompt,
      givenIndex: given === undefined ? null : given,
      givenText: given === undefined || given === null ? null : q.options[given],
      correctIndex: q.correctIndex,
      correctText: q.options[q.correctIndex],
      correct: correct,
      explanation: q.explanation,
      errorNote: q.errorNote
    };
  });

  const areaNames = [];
  detail.forEach(function (d) { if (areaNames.indexOf(d.area) < 0) areaNames.push(d.area); });

  return {
    score: score,
    total: session.total,
    percentage: Math.round((score / session.total) * 100),
    detail: detail,
    byArea: areaNames.map(function (a) {
      const items = detail.filter(function (d) { return d.area === a; });
      return { area: a, correct: items.filter(function (d) { return d.correct; }).length, total: items.length };
    })
  };
}

/* Stima trasparente: dipende dalle aree, dagli schemi per area e
   dall'ampiezza dei parametri. Nessun valore infinito. */
function variantEstimate(slug) {
  const def = AREA_INDEX[slug];
  if (!def) return 0;
  let schemi = 0;
  def.areas.forEach(function (a) {
    if (a.spec.sets) schemi += a.spec.sets.length * 4;
    if (a.spec.cases) schemi += a.spec.cases.length;
    if (a.spec.consequences) schemi += a.spec.consequences.length;
    if (a.spec.sequences) schemi += a.spec.sequences.length;
    if (a.spec.classes) schemi += a.spec.classes.length;
    if (a.spec.compute) schemi += 12;
  });
  if (!schemi) return 0;
  return Math.round(Math.pow(schemi * 6, 1.5));
}

export {
  QUESTIONS_PER_SESSION,
  MIN_AREAS,
  GENERATORS,
  EXAM_AREAS,
  AREA_INDEX,
  createRng,
  shuffleFisherYates,
  examCoverage,
  planDistribution,
  generateSession,
  gradeSession,
  variantEstimate
};
