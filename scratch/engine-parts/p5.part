  "diritto-commerciale": ["diritto-privato"],
  "diritto-del-lavoro": ["diritto-privato"],
  "diritto-di-famiglia": ["diritto-privato"],
  "diritto-processuale-civile": ["diritto-privato"],
  "diritto-processuale-penale": ["diritto-penale"],
  "diritto-penale-avanzato": ["diritto-penale"],
  "chimica-generale": ["chimica"],
  "chimica-organica": ["chimica"],
  "chimica-analitica": ["chimica"],
  "chimica-farmaceutica": ["chimica"],
  "chimica-fisica": ["chimica"],
  "chimica-inorganica": ["chimica"],
  "fisiologia-avanzata": ["fisiologia"],
  "fisiologia-dellesercizio": ["fisiologia"],
  "fisiologia-vegetale": ["fisiologia"],
  "anatomia-avanzata": ["anatomia"],
  "citologia": ["istologia"],
  "biologia-generale": ["istologia"],
  "biologia-molecolare": ["biochimica"],
  "genetica": ["biochimica"],
  "genetica-medica": ["biochimica"],
  "microbiologia": ["istologia"],
  "patologia-generale": ["fisiologia"],
  "statistica-economica": ["statistica"],
  "statistica-inferenziale": ["statistica"],
  "probabilita": ["statistica"],
  "algebra-lineare": ["analisi-matematica"],
  "geometria": ["analisi-matematica"],
  "matematica-generale": ["analisi-matematica"],
  "analisi-matematica-2": ["analisi-matematica"],
  "analisi-numerica": ["analisi-matematica"],
  "fisica-generale": ["statistica"],
  "fisica-medica": ["statistica"],
  "informatica": ["programmazione"],
  "algoritmi": ["programmazione"],
  "architettura-degli-elaboratori": ["programmazione"],
  "sistemi-operativi": ["programmazione"],
  "ingegneria-del-software": ["programmazione"],
  "reti-di-calcolatori": ["programmazione"],
  "microeconomia": ["economia-politica"],
  "macroeconomia": ["economia-politica"],
  "econometria": ["economia-politica"],
