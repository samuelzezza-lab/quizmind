/* ============================================================
   Quizmind — motore, parte 5 di 5
   Aree economiche, alias degli esami, indice finale, copertura,
   generazione della sessione da 10 domande e correzione.
   ============================================================ */

EXAM_AREAS["economia-politica"] = {
  name: "Economia politica",
  areas: [
    area("domanda", "Domanda e offerta", "conseguenza", {
      consequences: [
        { id: "prezzo", cause: "la domanda di un bene aumenta a parita di offerta", effect: "il prezzo di equilibrio tende a salire e la quantita scambiata ad aumentare" },
        { id: "offerta", cause: "l'offerta di un bene aumenta a parita di domanda", effect: "il prezzo di equilibrio tende a scendere e la quantita scambiata ad aumentare" },
        { id: "elasticita", cause: "la domanda e elastica rispetto al prezzo", effect: "una variazione del prezzo produce una variazione piu che proporzionale della quantita domandata" },
        { id: "tetto", cause: "si fissa un prezzo massimo inferiore al prezzo di equilibrio", effect: "si genera una penuria, con eccesso di domanda rispetto all'offerta" }
      ]
    }),
    area("pil", "Contabilita nazionale", "calcolo", {
      compute: function (rng) {
        const c = randInt(rng, 400, 900);
        const i = randInt(rng, 100, 300);
        const g = randInt(rng, 100, 300);
        const pil = c + i + g;
        return {
          prompt: "In un sistema chiuso agli scambi con l'estero, i consumi valgono " + c + ", gli investimenti " + i + " e la spesa pubblica " + g + " (milioni di euro). Qual e il PIL?",
          value: pil,
          unit: "milioni di euro",
          factor: 2,
          decimals: 0,
          explanation: "In economia chiusa il PIL e la somma di consumi, investimenti e spesa pubblica: " + c + " + " + i + " + " + g + " = " + fmt(pil) + ".",
          note: "Errore tipico: includere le esportazioni nette in un sistema chiuso agli scambi."
        };
      }
    }),
    area("inflazione", "Inflazione e indici", "calcolo", {
      compute: function (rng) {
        const p1 = randInt(rng, 100, 140);
        const p0 = randInt(rng, 80, 99);
        const tasso = Math.round(((p1 - p0) / p0) * 10000) / 100;
        return {
          prompt: "L'indice dei prezzi passa da " + p0 + " a " + p1 + ". Qual e il tasso di inflazione in percentuale? (2 decimali)",
          value: tasso,
          unit: "%",
          factor: 2,
          decimals: 2,
          explanation: "Il tasso e (p1 - p0)/p0 x 100 = (" + p1 + " - " + p0 + ")/" + p0 + " x 100 = " + fmt(tasso) + "%.",
          note: "Errore tipico: dividere la differenza per l'indice finale invece che per quello iniziale."
        };
      }
    }),
    area("mercati", "Forme di mercato", "classificazione", {
      classes: [
        { id: "concorrenza", label: "concorrenza perfetta", members: ["un mercato con molti venditori di un bene omogeneo"] },
        { id: "monopolio", label: "monopolio", members: ["un mercato con un solo venditore e barriere all'entrata"] },
        { id: "oligopolio", label: "oligopolio", members: ["un mercato con pochi venditori interdipendenti"] },
        { id: "concorrenza-monopolistica", label: "concorrenza monopolistica", members: ["un mercato con molti venditori di prodotti differenziati"] }
      ]
    })
  ]
};

EXAM_AREAS["economia-aziendale"] = {
  name: "Economia aziendale",
  areas: [
    area("bilancio", "Bilancio e patrimonio", "calcolo", {
      compute: function (rng) {
        const attivo = randInt(rng, 200, 900);
        const passivo = randInt(rng, 100, 400);
        const patrimonio = attivo - passivo;
        return {
          prompt: "Un'impresa ha attivo per " + attivo + " e passivita per " + passivo + " (migliaia di euro). Qual e il patrimonio netto?",
          value: patrimonio,
          unit: "migliaia di euro",
          factor: 2,
          decimals: 0,
          explanation: "Il patrimonio netto e la differenza tra attivo e passivita: " + attivo + " - " + passivo + " = " + fmt(patrimonio) + ".",
          note: "Errore tipico: sommare attivo e passivita invece di sottrarre."
        };
      }
    }),
    area("indici", "Indici di redditivita", "calcolo", {
      compute: function (rng) {
        const utile = randInt(rng, 10, 90);
        const ricavi = randInt(rng, 200, 900);
        const ros = Math.round((utile / ricavi) * 10000) / 100;
        return {
          prompt: "Un'impresa ha ricavi per " + ricavi + " e utile di " + utile + " (migliaia di euro). Qual e il margine di utile sui ricavi in percentuale? (2 decimali)",
          value: ros,
          unit: "%",
          factor: 2,
          decimals: 2,
          explanation: "Il margine e utile/ricavi x 100 = " + utile + "/" + ricavi + " x 100 = " + fmt(ros) + "%.",
          note: "Errore tipico: invertire il rapporto, dividendo i ricavi per l'utile."
        };
      }
    }),
    area("costi", "Costi e break even", "calcolo", {
      compute: function (rng) {
        const fissi = randInt(rng, 1000, 9000);
        const margine = randInt(rng, 10, 40);
        const bep = Math.ceil(fissi / margine);
        return {
          prompt: "Un'impresa ha costi fissi per " + fmt(fissi) + " euro e margine di contribuzione unitario di " + margine + " euro. Quante unita deve vendere per coprire i costi fissi?",
          value: bep,
          unit: "unita",
          factor: 2,
          decimals: 0,
          explanation: "Il punto di pareggio e costi fissi / margine unitario = " + fmt(fissi) + " / " + margine + " = " + fmt(bep) + " unita.",
          note: "Errore tipico: moltiplicare costi fissi e margine invece di dividere."
        };
      }
    }),
    area("gestione", "Gestione aziendale", "conseguenza", {
      consequences: [
        { id: "liquidita", cause: "l'impresa ha crediti rilevanti e scorte elevate", effect: "la liquidita e assorbita nel capitale circolante, con tensione finanziaria" },
        { id: "ammortamento", cause: "si acquista un impianto pluriennale", effect: "il costo viene ripartito negli esercizi attraverso l'ammortamento" },
        { id: "autofinanziamento", cause: "l'impresa non distribuisce tutto l'utile", effect: "si genera autofinanziamento che rafforza il patrimonio netto" },
        { id: "indebitamento", cause: "l'impresa ricorre a nuovo debito bancario", effect: "aumentano gli oneri finanziari e il rapporto di indebitamento" }
      ]
    })
  ]
};

/* ============================================================
   ALIAS E INDICE DELLE AREE
   Le aree specifiche hanno priorita sugli alias: un esame con
   aree proprie non viene coperto da una materia affine.
   ============================================================ */
